# Sao chép thành .env rồi sửa. docker compose tự đọc file này.

# Tên miền công khai (bắt buộc HTTPS để dùng GPS, camera và cài app lên điện thoại)
DOMAIN=chamcong.congty.vn
PUBLIC_URL=https://chamcong.congty.vn

# Tài khoản quản trị đầu tiên (chỉ có tác dụng lần chạy đầu, khi cơ sở dữ liệu còn trống).
# Hệ thống vẫn bắt đổi mật khẩu ở lần đăng nhập đầu.
ADMIN_CODE=admin
ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# Múi giờ của công ty. KHÔNG đổi sau khi đã có dữ liệu chấm công.
APP_TZ=Asia/Ho_Chi_Minh

# Đặt 1 khi chạy sau Caddy/Nginx để lấy đúng IP người dùng (cần cho chấm công theo WiFi).
TRUST_PROXY=1

# (Tuỳ chọn) khoá ký đăng nhập. Bỏ trống: tự sinh và lưu trong /data/.jwt_secret
# JWT_SECRET=

# Cổng và thư mục dữ liệu khi chạy bằng start.bat / start.sh (mặc định 3000 và thư mục data cạnh phần mềm)
# PORT=3000
# DATA_DIR=data

# Cập nhật trên web (Hệ thống → Cập nhật phần mềm) BẬT sẵn: quản trị viên chọn file là cập nhật.
# Muốn tắt hẳn thì bỏ dấu # ở dòng dưới. Muốn chỉ nhận gói có chữ ký: tạo khoá bằng node scripts/gen-update-key.js rồi điền UPDATE_PUBLIC_KEY.
# ALLOW_ONLINE_UPDATE=0
# UPDATE_PUBLIC_KEY=
